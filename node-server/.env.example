# این مقادیر را در بخش "Setup Node.js App" روی cPanel به‌عنوان
# Environment Variable اضافه کنید (نه اینکه فایل .env را آپلود کنید،
# چون بیشتر پیکربندی‌های cPanel این متغیرها را از رابط گرافیکی می‌خوانند).

# باید دقیقاً همان مقداری باشد که در پنل ادمین > تنظیمات > بخش Real-Time
# نمایش داده می‌شود (به‌صورت خودکار توسط PHP تولید می‌شود).
WS_SECRET=

# آدرس کامل سایت PHP، بدون / انتهایی
PHP_BASE_URL=https://your-domain.com
