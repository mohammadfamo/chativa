# اجازه‌ی نمایش فایل‌های آپلودشده (عکس/ویدیو/ویس) هست، اما هر فایلی با
# پسوند اجرایی/خطرناک مسدود می‌شود؛ صرفاً یک لایه‌ی دفاع اضافه، چون
# نام فایل‌ها همیشه توسط خود سرور و با پسوند امن ساخته می‌شوند.
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|jsp|asp|aspx|sh|cgi|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
