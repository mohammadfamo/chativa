# توجه: دایرکتیوهای Options و ServerSignature عمداً اینجا قرار داده نشده‌اند،
# چون روی بعضی هاست‌های cPanel که AllowOverride محدود دارند باعث خطای 500 می‌شوند.

# جلوگیری از دسترسی مستقیم به فایل‌های حساس
<FilesMatch "\.(sql|log|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
